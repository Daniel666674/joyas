# Copy this file to ".env" for local testing. On Vercel, add the same names
# under Project Settings > Environment Variables instead. NEVER commit a
# real key: ".env" is git-ignored on purpose.

# Which engine makes the 3D models.
#   mock  = fake results, free, for testing the page
#   meshy = the real Meshy API (spends credits)
PROVIDER=mock

# Secret key from the Meshy dashboard (only needed when PROVIDER=meshy).
MESHY_API_KEY=
# Cheapest model. Change only if quality is clearly too low.
MESHY_MODEL=meshy-6-lite
# Metal-like shine on the model (adds 30-60 s per task). Check "consumed_credits" on the first real run.
MESHY_ENABLE_PBR=true
# Ask Meshy to screen the customer's photo before generating. Meshy only supports
# this with MESHY_MODEL=meshy-6 (it is ignored by meshy-7.1 and rejected by
# meshy-6-lite), so it is only sent when the model is meshy-6.
MESHY_MODERATION=true
# Real generations are two steps: first Meshy redraws the photo as the chosen jewelry
# (image-to-image, about 3 credits), then makes the 3D model from that picture. Without
# step 1 the photo of a cat simply becomes a 3D cat. false = photo straight to 3D.
MESHY_RESTYLE=true
MESHY_RESTYLE_MODEL=nano-banana

# The code you hand to your client. REQUIRED when PROVIDER=meshy: the API
# refuses to run without it, so a forgotten setting can't leave it open.
DEMO_CODE=

# Saved orders ("Cotizar esta joya por WhatsApp"). Customer data goes to a PRIVATE
# Vercel Blob store, never into the public repo. Orders turn on when BLOB_READ_WRITE_TOKEN
# exists (created automatically when you connect a Blob store to the project).
# ADMIN_CODE is OPTIONAL: the code for the admin panel's "Pedidos IA" tab. Left empty, the
# DEMO_CODE opens it too (fine for a demo, but then the client can read the orders). Set a
# different value before real customers use the designer.
ADMIN_CODE=
BLOB_READ_WRITE_TOKEN=

# Websites allowed to call this API (comma separated, no trailing slash).
ALLOWED_ORIGINS=https://daniel666674.github.io

# Instant off switch. Set to false to pause the demo.
ENABLED=true

# Mock provider only: where the sample models live, and how long the fake
# "generation" takes.
MOCK_MODEL_BASE_URL=https://daniel666674.github.io/joyas/models/samples
MOCK_DURATION_MS=12000
