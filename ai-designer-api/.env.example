# Copy this file to ".env" for local testing. On Vercel, add the same names
# under Project Settings > Environment Variables instead. NEVER commit a
# real key: ".env" is git-ignored on purpose.

# Which engine makes the 3D models.
#   mock  = fake results, free, for testing the page
#   meshy = the real Meshy API (spends credits)
PROVIDER=mock

# Secret key from the Meshy dashboard (only needed when PROVIDER=meshy).
MESHY_API_KEY=
# Cheapest model. Change only if quality is clearly too low.
MESHY_MODEL=meshy-6-lite
# Metal-like shine on the model. Check "consumed_credits" on the first real run.
MESHY_ENABLE_PBR=true

# The code you hand to your client. REQUIRED when PROVIDER=meshy: the API
# refuses to run without it, so a forgotten setting can't leave it open.
DEMO_CODE=

# Websites allowed to call this API (comma separated, no trailing slash).
ALLOWED_ORIGINS=https://daniel666674.github.io

# Instant off switch. Set to false to pause the demo.
ENABLED=true

# Mock provider only: where the sample models live, and how long the fake
# "generation" takes.
MOCK_MODEL_BASE_URL=https://daniel666674.github.io/joyas/models/samples
MOCK_DURATION_MS=12000
